# Keep the Helius API key on the watcher server only.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=replace-me
# With API using the same key, combined API + watcher must stay <= 10.
# Example: watcher 8 and API 2.
RPC_REQUESTS_PER_SECOND=10
RPC_PROGRAM_ACCOUNTS_PER_SECOND=5
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=replace-me
# Dedicated non-owner login granted waffle_watcher only; never use the migration owner.
DATABASE_URL=postgresql://waffle_watcher_login:replace-me@localhost:5432/waffle
WATCHER_CONNECTIONS=2
WATCHER_STALE_SLOTS=150
WATCHER_STATUS_PORT=3002
# Structured server logs: info (default), warn, error, or silent.
LOG_LEVEL=info
# Quote-only evidence probes. No wallet, signature, or execution is requested.
JUPITER_API_KEY=replace-me
WATCHER_COPY_SIZE_LAMPORTS=50000000
# Optional. Only explicitly verified exact-mint USD feed IDs belong in this JSON object.
PYTH_API_KEY=
PYTH_PRICE_FEEDS_JSON={}

# Each watcher process watches ONE network. Default preserves existing Mainnet data.
SOLANA_NETWORK=mainnet
# Used when SOLANA_NETWORK=devnet (no Jupiter key required on Devnet).
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_WSS_URL=wss://api.devnet.solana.com
# Run bun run dev:watcher:devnet for a second watcher on status port 3003.
# Testnet is not a published PumpSwap deployment; the watcher reports this explicitly.

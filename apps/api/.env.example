# API runtime credential: a non-owner Neon login granted only waffle_api.
# URL-encode credential characters: a literal % becomes %25, @ becomes %40.
DATABASE_URL=postgresql://waffle_api_login:replace-me@your-neon-host/waffle?sslmode=require
API_HOST=127.0.0.1
API_PORT=3000
# Structured server logs: info (default), warn, error, or silent.
LOG_LEVEL=info
# Public HTTPS app identity used by wallet SIWS. Changing it invalidates pending challenges.
AUTH_URI=https://your-current-tunnel.trycloudflare.com
# Server-only Jupiter Swap V2 API key. Required for POST /paper-positions/quote; missing key returns 503 while listing remains available.
JUPITER_API_KEY=replace-me
# Required for current paper/real trade assessment; also enables pasted-wallet validation.
# Server-side only; never expose to the mobile app. Without it, tracking skips validation.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=replace-me
# Share the Helius budget with watcher: combined API + watcher <= 10 requests/sec.
# Example: API 2, watcher 8. Per-process limits are not account-wide.
# RPC_REQUESTS_PER_SECOND=2
# Optional current same-asset oracle checks (same configuration as watcher).
# PYTH_API_KEY=replace-me
# PYTH_PRICE_FEEDS_JSON={}
# Optional live delivery: separate non-owner login granted ONLY waffle_delivery, same database as DATABASE_URL.
# Without it /live returns 503 and the API logs that live delivery is disabled.
# DELIVERY_DATABASE_URL=postgresql://waffle_delivery_login:replace-me@your-neon-host/waffle?sslmode=require
# Optional FCM HTTP v1 service-account JSON (project_id, client_email, private_key).
# Set via secret environment injection or a single-quoted JSON value in this ignored app-local .env.
# Never put the service-account key in mobile config. Requires DELIVERY_DATABASE_URL.
# FCM_SERVICE_ACCOUNT_JSON='{"project_id":"your-project-id","client_email":"sender@your-project-id.iam.gserviceaccount.com","private_key":"replace-with-service-account-PEM"}'

# Direct Devnet PumpSwap quotes, simulation and execution; server-side only.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# API runtime credential: a non-owner Neon login granted only waffle_api.
DATABASE_URL=postgresql://waffle_api_login:replace-me@your-neon-host/waffle?sslmode=require
API_HOST=127.0.0.1
API_PORT=3000
# Public HTTPS app identity used by wallet SIWS. Changing it invalidates pending challenges.
AUTH_URI=https://your-current-tunnel.trycloudflare.com
# Server-only Jupiter Swap V2 API key. Required for POST /paper-positions/quote; missing key returns 503 while listing remains available.
JUPITER_API_KEY=replace-me
# Optional live delivery: separate non-owner login granted ONLY waffle_delivery, same database as DATABASE_URL.
# Without it /live returns 503 and the API logs that live delivery is disabled.
# DELIVERY_DATABASE_URL=postgresql://waffle_delivery_login:replace-me@your-neon-host/waffle?sslmode=require

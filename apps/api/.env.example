# API runtime credential: a non-owner Neon login granted only waffle_api.
DATABASE_URL=postgresql://waffle_api_login:replace-me@your-neon-host/waffle?sslmode=require
API_HOST=127.0.0.1
API_PORT=3000
# Server-only Jupiter Swap V2 API key. Required when wiring the Jupiter service into authenticated routes.
JUPITER_API_KEY=replace-me

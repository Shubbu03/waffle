# Use the public HTTPS domain you control for MWA identity and SIWS.
# Host /.well-known/assetlinks.json there for Android app verification.
EXPO_PUBLIC_WAFFLE_APP_URI=https://your-app-domain.example

# Public API origin. HTTP is allowed only in development.
# Android emulator: http://10.0.2.2:3000; iOS simulator: http://127.0.0.1:3000.
# Android preserves 10.0.2.2 so it can reach the host's loopback listener.
# Other local development origins follow Metro's LAN/localhost host automatically.
# Start the API separately; LAN devices also need API_HOST=0.0.0.0.
# Expo tunnels serve Metro only. Use a separate HTTPS API tunnel on remote devices.
EXPO_PUBLIC_WAFFLE_API_URL=https://your-api-domain.example

# Optional. Use a dedicated mainnet RPC for production; this URL is public in the app bundle.
# EXPO_PUBLIC_SOLANA_MAINNET_RPC_URL=https://your-public-mainnet-rpc.example

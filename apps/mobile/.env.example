# Use the public HTTPS domain you control for MWA identity and SIWS.
# Host /.well-known/assetlinks.json there for Android app verification.
EXPO_PUBLIC_WAFFLE_APP_URI=https://your-app-domain.example

# Public API origin. HTTP is allowed only in development (e.g. http://10.0.2.2:3000).
EXPO_PUBLIC_WAFFLE_API_URL=https://your-api-domain.example

# Optional. Use a dedicated mainnet RPC for production; this URL is public in the app bundle.
# EXPO_PUBLIC_SOLANA_MAINNET_RPC_URL=https://your-public-mainnet-rpc.example

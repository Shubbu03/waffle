{
  "name": "waffle",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '@waffle/*' typecheck",
    "test:shared": "bun run --filter '@waffle/shared' test",
    "test:db": "bun run --filter '@waffle/db' test",
    "test:api": "bun run --filter '@waffle/api' test",
    "test:watcher": "bun run --filter '@waffle/watcher' test",
    "dev:api": "bun run --filter '@waffle/api' dev",
    "start:api": "bun run --filter '@waffle/api' start",
    "db:check": "bun run --filter '@waffle/db' db:check",
    "db:generate": "bun run --filter '@waffle/db' db:generate",
    "db:migrate": "bun run --filter '@waffle/db' db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@types/bun": "^1.4.2"
  }
}
